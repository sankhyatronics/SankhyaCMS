[
    {
        "type": "Header",
        "id": "header-default",
        "label": "Default",
        "sticky": true,
        "className": "bg-(--st-color-surface) shadow-md shadow-(color:--st-shadow-color-md) max-w-[1920px] mx-auto rounded-b-xl",
        "logoHref": "/",
        "logoClassName": "w-[120px] md:w-[160px] lg:w-[180px]",
        "imageSrc": "/images/Logo_flat_color_2.svg",
        "altText": "Sankhyatronics",
        "children": [
            {
                "type": "IconButton",
                "id": "util-theme",
                "slot": "utility",
                "onClick": "@action:onThemeChangeClick",
                "icon": "mdi:theme-light-dark",
                "className": "bg-(--st-color-surface) hover:bg-(--st-color-hover) text-(color:--st-color-text-strong) p-2 rounded-full"
            },
            {
                "type": "MenuItem",
                "id": "menu-item-home",
                "title": "Home",
                "href": "/",
                "className": "bg-(--st-color-surface) hover:bg-(--st-color-hover) text-(color:--st-color-text-strong) rounded-sm px-4 py-2"
            },
            {
                "type": "Dropdown",
                "id": "menu-dropdown-services",
                "title": "Services",
                "mega": true,
                "openOnHover": true,
                "children": [
                    {
                        "type": "MegaMenu",
                        "id": "megamenu-services",
                        "heading": "Services",
                        "description": "From strategy to day-to-day operations — we plan, build and run the technology your business depends on.",
                        "featuredHeading": "Why Sankhyatronics",
                        "children": [
                            {
                                "type": "MenuItem",
                                "id": "services-intro-contact",
                                "slot": "intro",
                                "variant": "link",
                                "title": "Talk to an expert",
                                "href": "contact-us",
                                "icon": "mdi:message-outline"
                            },
                            {
                                "type": "MenuItem",
                                "id": "services-intro-values",
                                "slot": "intro",
                                "variant": "link",
                                "title": "Our values",
                                "href": "values",
                                "icon": "mdi:star-outline"
                            },
                            {
                                "type": "MegaMenuColumn",
                                "id": "services-column-engagement",
                                "heading": "Engagement models",
                                "children": [
                                    {
                                        "type": "MenuItem",
                                        "id": "menugrid-item-consultancy-service",
                                        "variant": "link",
                                        "title": "Consultancy Service",
                                        "href": "consultancy-services"
                                    },
                                    {
                                        "type": "MenuItem",
                                        "id": "menugrid-item-product-team-as-a-service",
                                        "variant": "link",
                                        "title": "Product Team as a Service",
                                        "href": "product-team-as-a-service",
                                        "badge": "New"
                                    },
                                    {
                                        "type": "MenuItem",
                                        "id": "menugrid-item-managed-services",
                                        "variant": "link",
                                        "title": "Managed Services",
                                        "href": "managed-services"
                                    }
                                ]
                            },
                            {
                                "type": "MegaMenuFeature",
                                "id": "services-feature-managed",
                                "slot": "featured",
                                "variant": "overlay",
                                "title": "Managed Services",
                                "description": "Outsource your IT needs and focus on your core business.",
                                "href": "managed-services"
                            }
                        ]
                    }
                ]
            },
            {
                "type": "Dropdown",
                "id": "menu-dropdown-help",
                "title": "Expertise",
                "mega": true,
                "openOnHover": true,
                "children": [
                    {
                        "type": "MegaMenu",
                        "id": "megamenu-expertise",
                        "heading": "Expertise",
                        "description": "Deep, hands-on experience across cloud, applications, AI and security.",
                        "featuredHeading": "Latest",
                        "children": [
                            {
                                "type": "MegaMenuColumn",
                                "id": "expertise-column-platforms",
                                "children": [
                                    {
                                        "type": "MegaMenuColumn",
                                        "id": "expertise-group-cloud",
                                        "heading": "Cloud & Operations",
                                        "children": [
                                            { "type": "MenuItem", "id": "menugrid-item-cloud-services", "variant": "link", "title": "Cloud Services", "href": "cloud-services" },
                                            { "type": "MenuItem", "id": "menugrid-item-business-operations", "variant": "link", "title": "Business Operations", "href": "business-operations" },
                                            { "type": "MenuItem", "id": "menugrid-item-modern-workspace", "variant": "link", "title": "Modern Workspace", "href": "modern-workspace" }
                                        ]
                                    },
                                    {
                                        "type": "MegaMenuColumn",
                                        "id": "expertise-group-security",
                                        "heading": "Security",
                                        "children": [
                                            { "type": "MenuItem", "id": "menugrid-item-cyber-security", "variant": "link", "title": "Cyber Security", "href": "cyber-security" }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "MegaMenuColumn",
                                "id": "expertise-column-build",
                                "heading": "Build",
                                "children": [
                                    { "type": "MenuItem", "id": "menugrid-item-application-development", "variant": "link", "title": "Application Development", "href": "application-development" },
                                    { "type": "MenuItem", "id": "menugrid-item-user-experience", "variant": "link", "title": "User Experience", "href": "user-experience" },
                                    { "type": "MenuItem", "id": "menugrid-item-agentics-ai", "variant": "link", "title": "Agentic AI Development", "href": "agentics-ai-development", "badge": "New" }
                                ]
                            },
                            {
                                "type": "MegaMenuFeature",
                                "id": "expertise-feature-ai",
                                "slot": "featured",
                                "description": "Leverage the power of AI with our agentic development services.",
                                "ctaLabel": "Explore agentic AI",
                                "href": "agentics-ai-development"
                            }
                        ]
                    }
                ]
            },
            {
                "type": "Dropdown",
                "id": "dropdown-products",
                "title": "Products",
                "mega": true,
                "openOnHover": true,
                "children": [
                    {
                        "type": "MegaMenu",
                        "id": "megamenu-products",
                        "children": [
                            {
                                "type": "MegaMenuColumn",
                                "id": "products-column-sankhya-ui",
                                "variant": "accent",
                                "heading": "Sankhya UI",
                                "description": "An open-source component library for headless CMS.",
                                "ctaLabel": "Visit Sankhya UI",
                                "ctaHref": "https://sankhyaui.sankhyatronics.com",
                                "children": [
                                    { "type": "MenuItem", "id": "products-sankhya-ui-docs", "variant": "link", "title": "Documentation", "href": "https://sankhyaui.sankhyatronics.com", "target": "_blank" }
                                ]
                            },
                            {
                                "type": "MegaMenuColumn",
                                "id": "products-column-sankhyabook",
                                "variant": "card",
                                "heading": "SankhyaBook 365",
                                "description": "An open-source SharePoint solution for multi-hierarchical knowledge management.",
                                "ctaLabel": "Visit SankhyaBook 365",
                                "ctaHref": "https://sankhyabook365.sankhyatronics.com",
                                "children": [
                                    { "type": "MenuItem", "id": "products-sankhyabook-overview", "variant": "link", "title": "Overview", "href": "https://sankhyabook365.sankhyatronics.com", "target": "_blank" }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "Dropdown",
                "id": "dropdown-aboutus",
                "title": "About Us",
                "mega": true,
                "openOnHover": true,
                "children": [
                    {
                        "type": "MegaMenu",
                        "id": "megamenu-aboutus",
                        "heading": "About Us",
                        "description": "Who we are, what we stand for and how to reach us.",
                        "children": [
                            {
                                "type": "MegaMenuColumn",
                                "id": "aboutus-column-company",
                                "heading": "Company",
                                "children": [
                                    { "type": "MenuItem", "id": "menugrid-item-values", "variant": "link", "title": "Our Values", "href": "values" },
                                    { "type": "MenuItem", "id": "menugrid-item-promises", "variant": "link", "title": "Our Promises", "href": "promises" }
                                ]
                            },
                            {
                                "type": "MegaMenuColumn",
                                "id": "aboutus-column-contact",
                                "heading": "Get in touch",
                                "children": [
                                    { "type": "MenuItem", "id": "menugrid-item-contactus", "variant": "link", "title": "Contact Us", "href": "contact-us" }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
