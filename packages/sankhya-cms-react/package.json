{
  "name": "@sankhyatronics/sankhya-cms-react",
  "description": "React wrappers for the Sankhya CMS Lit components, plus the JSON renderer (DynamicRenderer)",
  "keywords": [
    "react",
    "lit",
    "web-components",
    "cms",
    "json-driven"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sankhyatronics/SankhyaCMS.git",
    "directory": "packages/sankhya-cms-react"
  },
  "license": "MIT",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rich-editor": {
      "types": "./dist/rich-editor.d.ts",
      "import": "./dist/rich-editor.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/rich-editor.tsx --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@sankhyatronics/sankhya-cms": "workspace:^",
    "@sankhyatronics/sankhya-rich-editor": "workspace:^",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@sankhyatronics/oxlint-config": "workspace:*",
    "@sankhyatronics/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
