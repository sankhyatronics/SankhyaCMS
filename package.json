{
  "name": "sankhya-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Lit web components (st-*) and thin React wrappers for JSON-driven CMS portals",
  "license": "ISC",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm -r dev",
    "update-version": "node scripts/version-manager.mjs"
  }
}
